      choices: ["ก. ตักเตือนด้วยวาจา", "ข. ตักเตือนเป็นหนังสือ", "ค. พักงานโดยไม่ได้จ่ายค่าจ้าง", "ง. เลิกจ้างโดยไม่จ่ายค่าชดเชย"],
      correct: 0
    },
    {
      q: "30. หากพนักงานขาดงานครั้งแรก จะถูกพิจารณาโทษอย่างไร",
      choices: ["ก. ตักเตือนด้วยวาจา", "ข. ตักเตือนเป็นหนังสือ", "ค. พักงานโดยไม่จ่ายค่าจ้าง", "ง. เลิกจ้างโดยไม่จ่ายค่าชดเชย"],
      correct: 1
    },
  ];

  questions.forEach((qData) => {
    const item = form.addMultipleChoiceItem();
    item.setTitle(qData.q);
    item.setPoints(1); // 1 point per question (Total = 30)
    
    const choiceList = qData.choices.map((text, idx) => {
      return item.createChoice(text, idx === qData.correct);
    });
    
    item.setChoices(choiceList);
    item.setRequired(true);
  });

  Logger.log("✅ สร้าง Google Form 30 ข้อ สำเร็จแล้ว!");
  Logger.log("🔗 Edit URL: " + form.getEditUrl());
  Logger.log("🔗 Published URL (สำหรับพนักงานสอบ): " + form.getPublishedUrl());
}
