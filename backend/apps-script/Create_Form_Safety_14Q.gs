  questions.forEach((qData) => {
    const item = form.addMultipleChoiceItem();
    item.setTitle(qData.q);
    item.setPoints(1); // 1 point per question (Total = 14)
    
    const choiceList = qData.choices.map((text, idx) => {
      return item.createChoice(text, idx === qData.correct);
    });
    
    item.setChoices(choiceList);
    item.setRequired(true);
  });

  Logger.log("✅ สร้าง Google Form 14 ข้อ สำเร็จแล้ว!");
