  const deptItem = form.addTextItem();
  deptItem.setTitle("แผนก (Department)");
  deptItem.setRequired(true);

  const phaseItem = form.addMultipleChoiceItem();
  phaseItem.setTitle("รอบการทำแบบทดสอบ (Test Phase)");
