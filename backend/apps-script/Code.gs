    phaseItem.createChoice("ก่อนการอบรม (Pre-Test)"),
    phaseItem.createChoice("หลังการอบรม (Post-Test)")
  ]);
  phaseItem.setRequired(true);

  form.addPageBreakItem().setTitle("แบบทดสอบประเมินผลการปฐมนิเทศ (30 ข้อ)");

