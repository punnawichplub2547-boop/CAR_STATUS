# Where the frontend looks for the backend API.
#
# Running the backend directly (cd backend && npm run dev): it listens on 4000.
#   VITE_API_BASE_URL=http://localhost:4000
#
# Running it via docker compose: the container still listens on 4000 internally
# but is published on host port 4001 (4000 is already taken by a Windows/WSL
# networking process on the dev machine), so use:
#   VITE_API_BASE_URL=http://localhost:4001
VITE_API_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# docker compose — PostgreSQL credentials (read from this file as ".env").
# Copy this file to .env and set a strong, unique password on each server.
# .env is gitignored; never commit real credentials.
# ---------------------------------------------------------------------------
POSTGRES_DB=car_status
POSTGRES_USER=car_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
